{
  "manifest_version": 3,
  "name": "__MSG_extName__",
  "short_name": "QRight",
  "version": "0.1.0",
  "description": "__MSG_extDescription__",
  "default_locale": "en",
  "homepage_url": "https://github.com/lixiaolin94/qright",
  "permissions": [
    "contextMenus",
    "offscreen",
    "clipboardWrite",
    "scripting",
    "search"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
